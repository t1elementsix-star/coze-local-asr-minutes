# Local faster-whisper service
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MAX_AUDIO_MB=200
ASR_MAX_CONCURRENCY=1

# Comma-separated exact source hosts, for example files.example.com,host.docker.internal
AUDIO_ALLOWED_HOSTS=
# Keep false for an Internet-facing service. Set true only on a trusted private network.
ALLOW_PRIVATE_AUDIO_URLS=false

# Volcengine: new console authentication (preferred)
VOLC_ASR_API_KEY=
# Volcengine: legacy console authentication (use both fields together)
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc

# Volcengine proxy
PUBLIC_BASE_URL=https://asr-proxy.example.com
PROXY_TOKEN=replace-with-a-long-random-string
AUDIO_DIR=./audio_cache
MAX_AUDIO_MB=500
WORKER_COUNT=2
JOB_TTL_SECONDS=86400
DELETE_AUDIO_AFTER_JOB=true
COZE_URL_REWRITE_FROM=
COZE_URL_REWRITE_TO=

# Standalone Volcengine CLI
AUDIO_URL=https://files.example.com/meeting.mp3
POLL_INTERVAL_SECONDS=10
MAX_WAIT_SECONDS=10800
OUTPUT_DIR=outputs
